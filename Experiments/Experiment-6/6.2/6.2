SELECT * FROM EMPLOYEES

 -- SIMPLE VIEW

--  COLUMN  LEVEL
CREATE VIEW EMP_VIEW_KRG AS
SELECT EMP_ID, EMP_NAME 
FROM EMPLOYEES


SELECT * FROM EMP_VIEW_KRG

-- ROW LEVEL

CREATE VIEW EMP_VIEW_KRG_1 AS
SELECT EMP_ID, EMP_NAME 
FROM EMPLOYEES
WHERE EMP_ID=101

-- ROW LEVEL AND COLUMN LEVEL 

SELECT * FROM EMP_VIEW_KRG_1


DELETE FROM EMP_VIEW_KRG_1
WHERE EMP_ID=101




CREATE MATERIALIZED VIEW MV_EMP_VIEW_KRG AS
SELECT EMP_ID, EMP_NAME 
FROM EMPLOYEES
WITH NO DATA


SELECT * FROM MV_EMP_VIEW_KRG

REFRESH MATERIALIZED VIEW MV_EMP_VIEW_KRG
