SELECT * FROM Staff;


DECLARE

    CURSOR top_5_employees IS
        SELECT Name, Salary
        FROM Staff
        ORDER BY Salary DESC
        FETCH FIRST 5 ROWS ONLY;

    v_name   Staff.Name%TYPE;
    v_salary Staff.Salary%TYPE;

BEGIN

    OPEN top_5_employees;

    LOOP

        FETCH top_5_employees
        INTO v_name, v_salary;

        EXIT WHEN top_5_employees%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE(
            'Name: ' || v_name ||
            ' | Salary: ' || v_salary
        );

    END LOOP;

    CLOSE top_5_employees;

END;
