/*Write a query to find the dishes which cost more than the average cost of all the dishes at the restaurant. The output should have the columns f_name, f_cost, and f_type.*/
SELECT f_name, f_cost, f_type
FROM food
WHERE f_cost > (
    SELECT AVG(f_cost)
    FROM food
);


